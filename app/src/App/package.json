{
  "name": "andymeier-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:prism && npm run build:browser",
    "build:css": "tailwindcss --input input.css --output wwwroot/css/compiled.css --minify",
    "build:prism": "esbuild Client/prism.ts --bundle --format=iife --minify --outfile=wwwroot/scripts/prism.js",
    "build:browser": "esbuild Client/components.ts Client/privacy.ts Client/telemetry.ts --bundle --format=esm --minify --outdir=wwwroot/scripts",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/browser-instrumentation": "0.7.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/instrumentation-fetch": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/sdk-trace-web": "2.10.0",
    "prismjs": "1.30.0"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.6"
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.10.1",
    "@types/prismjs": "1.26.6",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
